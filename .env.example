# CivicPulse Master Environment Template

# Backend Settings
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace_with_a_secure_random_key_in_production
SESSION_EXPIRE_HOURS=24

# Database Connection (Neon PostgreSQL / Local)
DATABASE_URL=postgresql://user:password@host:5432/civicpulse_db

# Frontend URL for CORS
FRONTEND_URL=https://civicpulse.vercel.app

# Optional Standalone AI Engine Service URL (leave blank for in-process)
AI_ENGINE_URL=http://localhost:8001

# Frontend Environment Variables (for frontend/.env)
VITE_API_URL=https://civicpulse-backend.onrender.com
VITE_WS_URL=wss://civicpulse-backend.onrender.com/ws/live-feed

