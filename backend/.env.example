# CivicPulse Backend Environment Variables
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Security (Generate random 32+ char string in production)
SECRET_KEY=replace_with_a_secure_random_key_in_production
SESSION_EXPIRE_HOURS=24

# Database (PostgreSQL URL e.g. Neon or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/civicpulse_db

# Frontend URL for CORS
FRONTEND_URL=https://civicpulse.vercel.app

# Optional Decoupled AI Microservice URL (leave blank to run in-process)
AI_ENGINE_URL=

